[node name="DeckChangeConfirmation" type="ConfirmationDialog" parent="PauseCanvasLayer" unique_id=1987008535]
title = "确认更换卡组"
ok_button_text = "更换并清场"
dialog_text = "{file_name}
共 {card_types} 种牌，{card_count} 张牌。

这会取消所有玩家的卡牌操作，并删除全部散牌和牌堆。
随后生成完整的新公共牌堆和每位玩家的空牌堆。
正反面使用文件中的状态，本次更换仅在当前房间生效。"

[node name="DeckChangeMessage" type="AcceptDialog" parent="PauseCanvasLayer" unique_id=361688666]
title = "更换卡组"

[node name="ClearTableConfirmation" type="ConfirmationDialog" parent="PauseCanvasLayer" unique_id=299321470]
title = "确认一键清场"
ok_button_text = "确认清场"
dialog_text = "这会删除桌面上的全部散牌和现有牌堆，
并取消所有玩家正在进行的牌堆操作。

随后将在桌面中央重新生成一副完整牌，
以及每位玩家对应的空牌堆。
卡牌正反面状态会保留。"
cancel_button_text = "取消"

[node name="ClearCountersConfirmation" type="ConfirmationDialog" parent="PauseCanvasLayer" unique_id=592142970]
title = "确认一键清计数器"
