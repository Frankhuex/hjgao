[gd_scene format=3]

[ext_resource type="Script" path="res://chat_panel.gd" id="1_chat"]

[sub_resource type="StyleBoxFlat" id="StyleBoxFlat_chat"]
bg_color = Color(0.055, 0.071, 0.094, 0.92)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.3, 0.36, 0.44, 0.9)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6

[node name="ChatPanel" type="CanvasLayer"]
layer = 50
script = ExtResource("1_chat")

[node name="ChatPanel" type="PanelContainer" parent="."]
visible = false
layout_mode = 3
anchor_bottom = 1.0
offset_left = 16.0
offset_top = 72.0
offset_right = 336.0
offset_bottom = -16.0
grow_vertical = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_chat")

[node name="Margin" type="MarginContainer" parent="ChatPanel"]
layout_mode = 2
theme_override_constants/margin_left = 12
theme_override_constants/margin_top = 12
theme_override_constants/margin_right = 12
theme_override_constants/margin_bottom = 12

[node name="VBox" type="VBoxContainer" parent="ChatPanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="TitleRow" type="HBoxContainer" parent="ChatPanel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="ChatTitle" type="Label" parent="ChatPanel/Margin/VBox/TitleRow"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
text = "聊天"

[node name="CloseButton" type="Button" parent="ChatPanel/Margin/VBox/TitleRow"]
custom_minimum_size = Vector2(28, 28)
layout_mode = 2
focus_mode = 0
tooltip_text = "关闭聊天"
text = "×"

[node name="MessageHistory" type="RichTextLabel" parent="ChatPanel/Margin/VBox"]
custom_minimum_size = Vector2(0, 240)
layout_mode = 2
size_flags_vertical = 3
bbcode_enabled = false
scroll_following = false
selection_enabled = true

[node name="InputRow" type="HBoxContainer" parent="ChatPanel/Margin/VBox"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="MessageInput" type="TextEdit" parent="ChatPanel/Margin/VBox/InputRow"]
custom_minimum_size = Vector2(0, 72)
layout_mode = 2
size_flags_horizontal = 3
focus_mode = 1
placeholder_text = "输入消息…"
wrap_mode = 1

[node name="SendButton" type="Button" parent="ChatPanel/Margin/VBox/InputRow"]
custom_minimum_size = Vector2(64, 0)
layout_mode = 2
focus_mode = 0
text = "发送"

[node name="NotificationStack" type="VBoxContainer" parent="."]
layout_mode = 3
anchors_preset = 11
anchor_left = 1.0
anchor_right = 1.0
anchor_bottom = 1.0
offset_left = -256.0
offset_top = 88.0
offset_right = -16.0
offset_bottom = -16.0
grow_horizontal = 0
grow_vertical = 2
mouse_filter = 2
theme_override_constants/separation = 8

[connection signal="focus_entered" from="ChatPanel/Margin/VBox/InputRow/MessageInput" to="." method="_on_input_focus_entered"]
[connection signal="focus_exited" from="ChatPanel/Margin/VBox/InputRow/MessageInput" to="." method="_on_input_focus_exited"]
[connection signal="pressed" from="ChatPanel/Margin/VBox/InputRow/SendButton" to="." method="_on_send_button_pressed"]
[connection signal="pressed" from="ChatPanel/Margin/VBox/TitleRow/CloseButton" to="." method="_on_close_button_pressed"]
